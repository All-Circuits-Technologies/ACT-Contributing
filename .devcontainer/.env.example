# Optional per-user env file for the dev container. Copy to .devcontainer/.env
# (gitignored).
#
# Docker Compose auto-loads .devcontainer/.env and substitutes these values into
# docker-compose.yml. Values are NOT injected into the container automatically -
# docker-compose.yml forwards the ones it needs explicitly (currently GH_TOKEN,
# via its `environment:` block).
#
# Everything here is optional; the container starts fine without this file.

# --- GitHub CLI (gh) -------------------------------------------------------------------------
# A GitHub personal access token. gh prefers GH_TOKEN over any stored login. Set
# it to have gh authenticated automatically instead of running `gh auth login`.
# (Claude Code needs nothing here - just run `claude` in the container once and sign in.)
# GH_TOKEN=myGitHubToken

# --- Worktree mode (parallel agents) ---------------------------------------------------------
# Mount the project root (one level above this clone) at /workspaces so that
# `git worktree add`ed siblings (/workspaces/<branch>) are real host directories,
# visible from the host and persistent across rebuilds. Requires the on-disk
# layout described in README.md:
#
#   <project-root>/          <- mounted at /workspaces
#     act-contributing/      <- this clone; opened in VS Code; lands at /workspaces/act-contributing
#     <some-branch>/         <- `git worktree add`ed siblings, land at /workspaces/<some-branch>
#
# To enable worktree mode, uncomment both lines below:
#
# WORKSPACE_MOUNT_SOURCE=../..
# WORKSPACE_MOUNT_TARGET=/workspaces
